{
  "name": "f1-dashboard",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && npm run build:api",
    "build:api": "rolldown -c rolldown.api.config.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "pace": "node --experimental-strip-types --no-warnings=ExperimentalWarning scripts/pace/index.ts",
    "pu": "node --experimental-strip-types --no-warnings=ExperimentalWarning scripts/fia-pu/index.ts",
    "news": "node --env-file-if-exists=.env.local --experimental-strip-types --no-warnings=ExperimentalWarning scripts/news/index.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@tanstack/react-query": "^5.100.8",
    "@vercel/blob": "^2.8.0",
    "@vercel/functions": "^3.9.9",
    "embla-carousel-react": "^8.6.0",
    "pdfjs-dist": "^6.3.289",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-router-dom": "^7.14.2",
    "recharts": "^3.8.1",
    "tailwindcss": "^3.4.19",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.5.0",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "postcss": "^8.5.13",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.2",
    "vite": "^8.0.10"
  }
}
